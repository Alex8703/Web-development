<%- include('../partials/header') %>
<div class="page-heading mb-4">
    <div><p class="eyebrow mb-2">SPACES TO GATHER</p><h1 class="h2 mb-1">Faculty Venues</h1><p class="text-secondary mb-0">Explore the spaces available for your next event.</p></div>
    <a class="btn btn-primary" href="/venue/add">Add a venue</a>
</div>
<% if (venues.length) { %>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 g-lg-4">
    <% venues.forEach((venue) => { %>
    <div class="col"><article class="card venue-card h-100"><div class="card-body d-flex flex-column">
        <div class="venue-icon mb-3" aria-hidden="true">⌂</div><h2 class="h5"><%= venue.name %></h2><p class="text-secondary mb-2"><%= venue.location %></p>
        <p><span class="fw-semibold"><%= venue.capacity %></span> people</p>
        <% if (venue.facilities.length) { %><div class="d-flex flex-wrap gap-2 mb-3"><% venue.facilities.forEach((facility) => { %><span class="badge facility-badge"><%= facility %></span><% }) %></div><% } %>
        <% if (venue.description) { %><p class="small text-secondary"><%= venue.description %></p><% } %>
        <a href="/venue/edit/<%= venue._id %>" class="btn btn-outline-primary btn-sm mt-auto align-self-start">Edit venue</a>
    </div></article></div>
    <% }) %>
</div>
<%- include('../partials/pagination', { page, totalPages, listPath: '/venues' }) %>
<% } else { %>
<div class="empty-state text-center py-5"><h2 class="h4">No venues yet</h2><p>Add a venue to make it available when scheduling events.</p><a class="btn btn-primary" href="/venue/add">Add a venue</a></div>
<% } %>
<%- include('../partials/footer') %>
